{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "betzone",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",

  "assets": {
    "directory": "."
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
